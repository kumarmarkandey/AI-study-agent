# Example environment variables for backend
# Copy to .env and fill values before running/deploying

PORT=5000

# MySQL / MariaDB settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=studysphere
DB_PORT=3306

# JWT secret used to sign authentication tokens
JWT_SECRET=change_this_to_a_strong_secret

# Node environment
NODE_ENV=production
